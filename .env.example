# Change this before starting the API server.
RAS_AUTH_TOKEN=replace-with-a-long-random-token

# Match the host user that owns workspace/ and the GH token file.
REMOTE_UID=1000
REMOTE_GID=1000

# Keep the API local by default. Set to 0.0.0.0 to expose it on the LAN.
REMOTE_AGENT_BIND=127.0.0.1
REMOTE_AGENT_PORT=8421

# Optional GH_TOKEN file. Replace with ./secrets/github_token after creating it.
GH_TOKEN_FILE=./secrets/github_token.example
